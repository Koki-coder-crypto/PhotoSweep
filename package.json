    "expo-router": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.0",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.20.0"
