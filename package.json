{
  "name": "photosweep",
  "version": "1.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "jest --runInBand",
    "check": "npm run typecheck && npm test && npm run test:ui && npm run doctor",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web",
    "release:check": "node tools/release-check.mjs",
    "build:development": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:ios": "npm run release:check && eas build --platform ios --profile production",
    "check:release-bundle": "node tools/check-release-bundle.mjs",
    "pretypecheck": "node tools/generate-route-types.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.0",
    "expo-build-properties": "~57.0.2",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.0",
    "expo-iap": "4.7.0",
    "expo-image": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.10",
    "expo-media-library": "~57.0.0",
    "expo-notifications": "~57.0.2",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.1",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.17.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
