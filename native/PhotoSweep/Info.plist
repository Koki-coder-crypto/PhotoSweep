<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>PhotoSweep</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string><key>UIImageName</key><string>BrandMark</string></dict>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>NSPhotoLibraryUsageDescription</key><string>Choose photos and videos to review, compare and delete. Analysis stays on your iPhone.</string>
<key>NSPhotoLibraryAddUsageDescription</key><string>Save compressed videos to your photo library. Originals stay until you choose to delete them.</string>
<key>ITSAppUsesNonExemptEncryption</key><false/>
</dict></plist>
